
c-----------------------------------------------------------------------
c  nek5000 user-file template
c
c  user specified routines:
c     - uservp  : variable properties
c     - userf   : local acceleration term for fluid
c     - userq   : local source term for scalars
c     - userbc  : boundary conditions
c     - useric  : initial conditions
c     - userchk : general purpose routine for checking errors etc.
c     - userqtl : thermal divergence for lowMach number flows 
c     - usrdat  : modify element vertices 
c     - usrdat2 : modify mesh coordinates
c     - usrdat3 : general purpose routine for initialization
c     
c-----------------------------------------------------------------------
      subroutine uservp (ix,iy,iz,ieg)
      include 'SIZE'
      include 'TOTAL'

      return
      end
c-----------------------------------------------------------------------
      subroutine userf(ix,iy,iz,eg) ! set acceleration term
      include 'SIZE'
      include 'TOTAL'

      return
      end
c-----------------------------------------------------------------------
      subroutine userq  (ix,iy,iz,ieg)
      include 'SIZE'
      include 'TOTAL'
      include 'NEKUSE'
      real alphan, alphab, b0, N0, R_0, u_avg, N_bar
      real dn, db, g
      b0 = 1.7e-14
      N0 = 100
      N_bar = 20
      R_0 = 2e-2
      u_avg = 120e-6
      g = 1e-6
      alphan = 2.8e7
      alphab = 2e-3

c      dn = alphan*R*b0/(u_avg*N0)
c      db = alphab*R/u_avg
      dn =param(50)
      db =param(51)
      if (ifield.eq.3) then
         ps2 = ps(2)
         ps1 = ps(1)
	 qvol = -(dn*ps2*ps1/(0.1+ps1))
c	 print *, 'qvol_s1 = ', qvol
      elseif (ifield.eq.4) then
             ps1 = ps(1)
             ps2 = ps(2)
             qvol = db*ps2*ps1/(0.1+ps1)
c	     print *, 'qvol_s2 = ', qvol
      elseif (ifield.eq.5) then
c             ps1 = ps(1)
c             ps2 = ps(2)
c	     ps3 = ps(3)
c             qvol = -(dn*ps3*ps1/(0.1+ps1))
      endif

      return
      end
c-----------------------------------------------------------------------
      subroutine userbc(ix,iy,iz,iside,ieg) ! set up boundary conditions
      include 'SIZE'
      include 'TOTAL'
      include 'NEKUSE'

      integer ix,iy,iz,ieg,ie
 
      real alpha, D, A, omega, uc, b
      real re, vel
      complex*16 i, z1, z2, J0z1, J0z2
  
      parameter (i = (0.0d0, 1.0d0)) 
      real part1, part2
      integer max_m
      parameter (max_m = 30)

      real factorial(max_m + 1)
      integer m
    
      re = param(2)
      vel = ((1/re)*1e-6)/(0.015)
      ! Initialize the parameters
      uc = 1.0
c      if (y. ge. 0.9) then
c         A = 0
c      else
      A = param(3)
c      endif
      f = param(4)
      D = 0.015
      alpha = D*SQRT(2.0 * pi * f/(1e-6))
      
      omega = 2.0 * pi * f * D/vel
         
      factorial(1) = 1.0
      do m = 2, max_m + 1
      	 factorial(m) = factorial(m-1) * (m-1)
      enddo
      
      ! Calculate the argument for the Bessel function
c      if (y. le. 0.9) then
      z1 = i**1.5 * alpha * y
c      else
c        z1 = 0
c      endif
      z2 = i**1.5 * alpha

      J0z1 = 0.0
      J0z2 = 0.0

      ! New approximation up to 30 terms
      
      do m = 0, max_m
      	 J0z1 = J0z1 + ((-1.0)**m / (factorial(m+1)**2)) *
     $        (z1/2.0)**(2 * m)
         J0z2 =	J0z2 + ((-1.0)**m / (factorial(m+1)**2)) *
     $        (z2/2.0)**(2 * m)     
      enddo

c      if (y. ge. 0.9) then 
c         part1 = 0.0
c      else
      part1 = 1.0 - (y)**2
c      endif
      
      part2 = real((1.0 - (J0z1 / J0z2)))

      ! Calculate the velocity components
c      ux = uc * (part1 + A * part2 * SIN(omega * time))
      ux = 0.0
c      ux = part1
c      ux = 
      uy = 0.0
      uz = 0.0
      temp = 0.0
      return
      end

c-----------------------------------------------------------------------
      subroutine useric(ix,iy,iz,eg) ! set up initial conditions
c     implicit none
      integer ix,iy,iz,eg

      include 'SIZE'
      include 'TOTAL'
      include 'NEKUSE'


     
c      if (y. le. 0.1) then
c         ux = 0.0
c      else
      ux   = 1-(y)**2
c      endif
c      ux   = 1.0*(1-((1-y)/0.9)**2)
c      ux   = 0.0
      uy   = 0.0
      uz   = 0.0

      temp = 0.0
      return
      end
