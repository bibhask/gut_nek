c-----------------------------------------------------------------------
      subroutine usrdat2()  ! This routine to modify mesh coordinates
c     implicit none
      include 'SIZE'
      include 'TOTAL'

      integer e, f
      real    sn(3), sr(3), tol
      real    tmp(lx1, ly1, lz1, nelt)
      real    xmid, ymid, zmid
      real    xref, yref, zref
      real    dxref, dyref, dzref, rtmp

      common /clcd/ U0,alpha,cos_alpha,sin_alpha


      do iel=1,nelv
      do ifc=1,2*ndim
        id_face = bc(5,ifc,iel,1)
        if (id_face.eq.329) then
            cbc(ifc,iel,1) = 'v  '
         elseif (id_face.eq.330) then
            cbc(ifc,iel,1) = 'O  '
         elseif (id_face.eq.331) then
            cbc(ifc,iel,1) = 'W  '
         elseif (id_face.eq.329) then
            cbc(ifc,iel,1) = 'A  '
         endif

      enddo
      enddo

c      call gen_rea_full(2)
      return
      end
